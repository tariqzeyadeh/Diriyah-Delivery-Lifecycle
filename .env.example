# ─────────────────────────────────────────────
# Diriyah environment template
# Copy to `.env` for local / Docker demo use.
# ─────────────────────────────────────────────

# --- MySQL (docker-compose `db` service) ---
MYSQL_ROOT_PASSWORD=atlas_root_secret
MYSQL_DATABASE=atlas_db
MYSQL_USER=atlas_user
MYSQL_PASSWORD=atlas_secret
MYSQL_PORT=3306
APP_PORT=3000

# --- Prisma / Next.js (host tools: prisma db push, seed, next dev) ---
# Use 127.0.0.1 when MySQL is published from Docker to the host.
DATABASE_URL="mysql://atlas_user:atlas_secret@127.0.0.1:3306/atlas_db"

# Public app URL (links, Playwright, future SSO callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-long-random-string"

# Auth mode: `demo` keeps the POC persona switcher; `sso` enables Entra ID only
AUTH_MODE=demo

# Observability
LOG_LEVEL=info
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# CRON jobs (/api/cron/*) — Vercel Cron / Azure Logic Apps Bearer token
CRON_SECRET=replace-with-long-random-cron-secret

# --- Microsoft Entra ID / Azure AD (NextAuth AzureADProvider) ---
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
# Optional JSON map: { "Tech-Gov-Group": "Strategy & Governance", ... }
# AZURE_AD_GROUP_ROLE_MAP=

# --- Evidence Vault (S3-compatible: AWS S3 or Azure Blob S3 gateway) ---
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=atlas-evidence-vault
# S3_ENDPOINT=                 # optional MinIO / Azure bridge
# S3_FORCE_PATH_STYLE=true

# --- SAP / MuleSoft integration ---
SAP_INTEGRATION_API_KEY=
SAP_INTEGRATION_TOKEN=
# SAP_INTEGRATION_ALLOW_INSECURE=true   # local scaffold only — never in production

# Inside the app container, docker-compose injects:
# mysql://atlas_user:atlas_secret@db:3306/atlas_db
# (do not point the container at 127.0.0.1)

# --- Diriyah Copilot (Vercel AI SDK) ---
# POC: standard OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
#
# Enterprise: Azure OpenAI (preferred for data residency)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Observability / APM (OpenTelemetry via @vercel/otel) ---
OTEL_SERVICE_NAME=diriyah
# OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Load testing (k6) — Bearer token bypasses POC API rate limit ---
LOAD_TEST_TOKEN=atlas-load-test-token

# --- Event-driven ERP sync (Azure Event Grid / SAP CloudEvents) ---
# ERP_WEBHOOK_HMAC_SECRET=
# ERP_WEBHOOK_ALLOW_INSECURE=true   # local scaffold only

# Playwright (optional)
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
