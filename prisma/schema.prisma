  master_trace_id         String            @db.VarChar(64)
  entity_type             String            @db.VarChar(64)
  parent_record_id        String?           @db.VarChar(255)
  entry_route             EntryRoute
  lifecycle_phase         String?           @db.VarChar(64)
  current_stage_code      String?           @db.VarChar(255)
  record_status           String?           @db.VarChar(64)
  approval_status         ApprovalDecision?
  rag_status              RagStatus?
  owning_business_unit_id String?           @db.VarChar(255)
  record_owner_user_id    String?           @db.VarChar(128)
  delegate_user_id        String?           @db.VarChar(128)
  fiscal_year             Int?
  version_number          Int               @default(1)
  version_status          VersionStatus?
  created_by              String            @db.VarChar(128)
  created_at              DateTime          @default(now())
  modified_by             String?           @db.VarChar(128)
  modified_at             DateTime?         @updatedAt
  submitted_by            String?           @db.VarChar(128)
  submitted_at            DateTime?
  source_system           String?           @db.VarChar(64)
  external_system_key     String?           @db.VarChar(255)
  last_sync_at            DateTime?
  data_classification     String?           @db.VarChar(64)
  retention_class         String?           @db.VarChar(255)
  is_active               Boolean           @default(true)
  is_locked               Boolean           @default(false)

  kpi KpiDefinition @relation(fields: [kpi_id], references: [kpi_id], onDelete: Restrict)

