// Diriyah — Exhaustive Prisma schema
// Source: Pre-Initiation_POC_Templates_and_Data_Dictionary R.xlsx
// Sheets: 02_ID Relationships, 04_Shared Fields, 05_Strategy, 06_Objectives,
//         07_KPI Register, 08_KPI Updates, 10_Demand Business Case,
//         11_Budget Header, 12_Budget Lines, 13_Budget Consolidation,
//         14_Procurement Plan, 15_Procurement Updates, 16_Project Registration,
//         17_Approvals, 18_Evidence Comments,
//         20_Status Lookups (BR-008 / BR-026 / BR-027 governance)
// Mapping: Long Text->Text; Currency/Decimal/Percentage->Decimal(18,2);
//          Repeatable*/Multi*/Structured/Polymorphic->Json; child entities->models.
// Invariants: every business model includes SHR; governance models are append-oriented;
//             onDelete Restrict; no hard deletes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum EntryRoute {
  STRATEGIC
  ADHOC
}

enum StrategyStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
  REJECTED
}

enum DemandStatus {
  DRAFT
  SUBMITTED
  UNDER_VALIDATION
  VALIDATED
  CONDITIONAL
  RETURNED
  INCLUDED
  FUNDED
  DEFERRED
  NOT_FUNDABLE
  CANCELLED
}

enum BudgetStatus {
  DRAFT
  CONSOLIDATING
  SUBMITTED
  RETURNED
  APPROVED
  APPROVED_COND
  REJECTED
}

enum ProcurementStage {
  PLANNED
  PR_PREP
  PR_APPROVAL
  RFX
  EVALUATION
  AWARD
  COMMITMENT
  DELIVERY
  ACCEPTANCE
  COMPLETED
  CANCELLED
}

enum ProcurementHealth {
  NOT_STARTED
  ON_TRACK
  AT_RISK
  DELAYED
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum PmoHandoffStatus {
  NOT_APPLICABLE
  NOT_READY
  READY
  SENT
  ACCEPTED
  RETURNED
}

enum ApprovalDecision {
  PENDING
  APPROVED
  APPROVED_COND
  RETURNED
  REJECTED
  WITHDRAWN
}

enum RagStatus {
  GREEN
  AMBER
  RED
  NOT_RATED
}

enum DecisionEnum {
  PENDING
  APPROVED
  APPROVED_COND
  RETURNED
  REJECTED
  WITHDRAWN
}

enum VirusScanStatus {
  PENDING
  CLEAN
  PASSED
  QUARANTINED
  FAILED
}

enum ResolutionStatus {
  OPEN
  RESPONDED
  RESOLVED
  REOPENED
  NOT_APPLICABLE
}

enum NotificationStatus {
  PENDING
  SENT
  PARTIALLY_FAILED
  FAILED
}

enum LockReleaseAction {
  KEEP_LOCKED
  CREATE_REVISION
  RELEASE_FOR_NEXT_STAGE
  CLOSE
}

enum CommentType {
  GENERAL
  CLARIFICATION
  VALIDATION_FINDING
  RETURN_INSTRUCTION
  APPROVAL_COMMENT
  SYSTEM_NOTE
}

enum AttachmentClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum Perspective {
  FINANCIAL
  CUSTOMER
  INTERNAL
  LEARNING
}

enum RaidcType {
  RISK
  ISSUE
  ASSUMPTION
  DEPENDENCY
  CONSTRAINT
}

enum VersionStatus {
  WORKING
  SUBMITTED
  APPROVED
  SUPERSEDED
  ARCHIVED
}

// ─────────────────────────────────────────────
// Master Traceability Spine
// ─────────────────────────────────────────────

model MasterTrace {
  master_trace_id String     @id @db.VarChar(64)
  entry_route     EntryRoute
  created_at      DateTime   @default(now())
  created_by      String     @db.VarChar(128)
  is_active       Boolean    @default(true)

  strategies         Strategy[]
  demands            Demand[]
  budget_submissions BudgetSubmission[]
  procurement_plans  ProcurementPlan[]
  procurement_items  ProcurementItem[]
  projects           ProjectRegistration[]
  approvals          ApprovalTransaction[]
  attachments        Attachment[]
  comments           Comment[]

  @@map("master_trace")
}

model Strategy {
  strategy_id                     String    @id @db.VarChar(64)
  strategy_title                  String    @db.VarChar(255)
  strategy_type                   String?   @db.VarChar(255)
  parent_strategy_id              String?   @db.VarChar(255)
  horizon_start_date              DateTime?
  horizon_end_date                DateTime?
  baseline_fiscal_year            Int?
  executive_sponsor_user_id       String?   @db.VarChar(128)
  strategy_owner_user_id          String?   @db.VarChar(128)
  performance_manager_user_id     String?   @db.VarChar(128)
  executive_summary               String?   @db.Text
  mandate_statement               String?   @db.Text
  vision_statement                String?   @db.Text
  mission_statement               String?   @db.Text
  strategic_drivers               Json?
  current_state_summary           String?   @db.Text
  trend_summary                   String?   @db.Text
  swot_summary                    String?   @db.Text
  target_state_description        String?   @db.Text
  strategic_theme_ids             Json?
  strategic_priorities            Json?
  key_outcomes                    Json?
  scope_in                        String?   @db.Text
  scope_out                       String?   @db.Text
  target_beneficiaries            Json?
  funding_envelope                Decimal?  @db.Decimal(18, 2)
  currency_code                   String?   @db.VarChar(255)
  indicative_capex                Decimal?  @db.Decimal(18, 2)
  indicative_opex                 Decimal?  @db.Decimal(18, 2)
  annual_funding_profile          Json?
  funding_source                  Json?
  review_frequency                String?   @db.VarChar(255)
  performance_reporting_frequency String?   @db.VarChar(255)
  decision_forums                 Json?
  key_assumptions                 String?   @db.Text
  key_constraints                 String?   @db.Text
  strategic_risks                 Json?
  objectives_complete             Boolean?
  scorecard_complete              Boolean?
  requested_effective_date        DateTime?

  // Shared fields (04_Shared Fields)
  master_trace_id         String            @db.VarChar(64)
  entity_type             String            @db.VarChar(64)
  parent_record_id        String?           @db.VarChar(255)
  entry_route             EntryRoute
  lifecycle_phase         String?           @db.VarChar(64)
  current_stage_code      String?           @db.VarChar(255)
  record_status           String?           @db.VarChar(64)
  approval_status         ApprovalDecision?
  rag_status              RagStatus?
  owning_business_unit_id String?           @db.VarChar(255)
  record_owner_user_id    String?           @db.VarChar(128)
  delegate_user_id        String?           @db.VarChar(128)
  fiscal_year             Int?
  version_number          Int               @default(1)
  version_status          VersionStatus?
  created_by              String            @db.VarChar(128)
  created_at              DateTime          @default(now())
  modified_by             String?           @db.VarChar(128)
  modified_at             DateTime?         @updatedAt
  submitted_by            String?           @db.VarChar(128)
  submitted_at            DateTime?
  source_system           String?           @db.VarChar(64)
  external_system_key     String?           @db.VarChar(255)
  last_sync_at            DateTime?
  data_classification     String?           @db.VarChar(64)
  retention_class         String?           @db.VarChar(255)
  is_active               Boolean           @default(true)
  is_locked               Boolean           @default(false)

  master_trace       MasterTrace          @relation(fields: [master_trace_id], references: [master_trace_id], onDelete: Restrict)
  themes             StrategicTheme[]
  objectives         StrategicObjective[]
  scorecards         BalancedScorecard[]
  demands            Demand[]
  budget_submissions BudgetSubmission[]
  procurement_plans  ProcurementPlan[]

  @@index([master_trace_id])
  @@map("strategy")
}

// ─────────────────────────────────────────────
// Strategic Theme (02_ID Relationships — THM entity)
// ─────────────────────────────────────────────

model StrategicTheme {
