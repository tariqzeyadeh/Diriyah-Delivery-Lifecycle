// ─────────────────────────────────────────────
// Balanced Scorecard Snapshot (09_Balanced Scorecard)
// ─────────────────────────────────────────────

model BalancedScorecard {
  scorecard_id                    String     @id @db.VarChar(64)
  strategy_id                     String     @db.VarChar(64)
  // BSC-003/004
  reporting_period                String     @db.VarChar(20) // YYYY-MM or YYYY-Qn
  data_as_of_date                 DateTime?
  // Perspective lines (BSC-005 to BSC-015) — stored as repeatable JSON
  perspective_lines               Json?
  // Delivery counts (BSC-016 to BSC-020)
  linked_demand_count             Int?
  linked_procurement_count        Int?
  linked_project_count            Int?
  project_contribution_weight_pct Decimal?   @db.Decimal(5, 2)
  weighted_project_progress_pct   Decimal?   @db.Decimal(5, 2)
  // Financial (BSC-021/022/023)
  approved_budget_sar             Decimal?   @db.Decimal(18, 2)
  comparison_value_sar            Decimal?   @db.Decimal(18, 2)
  budget_performance_score        Decimal?   @db.Decimal(5, 2)
  // Component weights (BSC-024/025)
  kpi_component_weight_pct        Decimal?   @db.Decimal(5, 2) // default 70%
  budget_component_weight_pct     Decimal?   @db.Decimal(5, 2) // default 10%
  // Scores (BSC-026 to BSC-029)
  composite_objective_score       Decimal?   @db.Decimal(5, 2)
  perspective_score               Decimal?   @db.Decimal(5, 2)
  overall_strategy_score          Decimal?   @db.Decimal(5, 2)
  overall_strategy_rag            RagStatus?
  // Narrative (BSC-030)
  executive_narrative             String?    @db.Text
  // Snapshot metadata
  is_published                    Boolean    @default(false)
  published_at                    DateTime?
  data_quality_status             String?    @db.VarChar(64) // PASS | DATA_QUALITY_FAILURE

  // Shared fields (04_Shared Fields)
  master_trace_id         String            @db.VarChar(64)
  entity_type             String            @db.VarChar(64)
  parent_record_id        String?           @db.VarChar(255)
  entry_route             EntryRoute
  lifecycle_phase         String?           @db.VarChar(64)
  current_stage_code      String?           @db.VarChar(255)
  record_status           String?           @db.VarChar(64)
  approval_status         ApprovalDecision?
  rag_status              RagStatus?
  owning_business_unit_id String?           @db.VarChar(255)
  record_owner_user_id    String?           @db.VarChar(128)
  delegate_user_id        String?           @db.VarChar(128)
  fiscal_year             Int?
  version_number          Int               @default(1)
  version_status          VersionStatus?
  created_by              String            @db.VarChar(128)
  created_at              DateTime          @default(now())
  modified_by             String?           @db.VarChar(128)
  modified_at             DateTime?         @updatedAt
  submitted_by            String?           @db.VarChar(128)
  submitted_at            DateTime?
  source_system           String?           @db.VarChar(64)
  external_system_key     String?           @db.VarChar(255)
  last_sync_at            DateTime?
  data_classification     String?           @db.VarChar(64)
  retention_class         String?           @db.VarChar(255)
  is_active               Boolean           @default(true)
  is_locked               Boolean           @default(false)

  strategy Strategy @relation(fields: [strategy_id], references: [strategy_id], onDelete: Restrict)

  @@index([strategy_id])
  @@index([reporting_period])
  @@index([master_trace_id])
  @@map("balanced_scorecard")
}

model Demand {
  demand_id                        String    @id @db.VarChar(64)
  demand_title                     String    @db.VarChar(255)
  demand_type                      String?   @db.VarChar(255)
  demand_category                  String?   @db.VarChar(255)
  demand_subcategory               String?   @db.VarChar(255)
  requesting_department_id         String?   @db.VarChar(255)
  requesting_location_entity       Json?
  requester_user_id                String?   @db.VarChar(128)
  business_owner_user_id           String?   @db.VarChar(128)
  executive_sponsor_user_id        String?   @db.VarChar(128)
  strategic_classification         String?   @db.VarChar(255)
  origin_channel                   String?   @db.VarChar(255)
  strategy_id                      String?   @db.VarChar(255)
