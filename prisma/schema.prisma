// ─────────────────────────────────────────────
// Budget Consolidation Snapshot (13_Budget Consolidation)
// ─────────────────────────────────────────────

model BudgetConsolidation {
  consolidation_id               String   @id @db.VarChar(64)
  budget_submission_id           String   @unique @db.VarChar(64)
  // CON-002 to CON-010 (existing)
  included_business_units        Json?
  included_demand_count          Int      @default(0)
  excluded_demand_count          Int      @default(0)
  requested_amount_sar           Decimal? @db.Decimal(18, 2) // CON-005
  recommended_amount_sar         Decimal? @db.Decimal(18, 2) // CON-006
  funding_ceiling_sar            Decimal  @db.Decimal(18, 2) // CON-007
  funding_gap_sar                Decimal  @db.Decimal(18, 2) // CON-008
  strategic_adhoc_mix            Json? // CON-009
  capex_opex_mix                 Json? // CON-010
  // CON-011 to CON-021 (previously missing)
  commitment_mix                 Json? // CON-011 New/Existing/Renewal/Run-cost split
  multi_year_commitment_profile  Json? // CON-012 FY + value
  priority_distribution          Json? // CON-013 Band + count + value
  demand_line_reconciliation     String   @db.VarChar(255) // CON-014
  line_phasing_reconciliation    String?  @db.VarChar(32) // CON-015 Pass | Fail
  accounting_dimensions_check    String?  @db.VarChar(32) // CON-016 Pass | Warning | Fail
  unresolved_findings_count      Int      @default(0) // CON-017
  funding_recommendation_summary String?  @db.Text // CON-018 (mandatory before CTO submit)
  specific_decision_items        Json? // CON-019 repeatable exception items
  consolidation_risks            Json? // CON-020 repeatable risk items
  proposed_conditions            Json? // CON-021 repeatable conditions
  // CON-022 to CON-025 (approval)
  submitted_version_hash         String?  @db.VarChar(128) // CON-022
  cto_decision                   String?  @db.VarChar(64) // CON-023 Approved | Approved_Cond | Returned | Rejected
  return_allocation              Json? // CON-024 repeatable entity + owner + due
  decision_comments              String?  @db.Text // CON-025

  // Shared fields (04_Shared Fields)
  master_trace_id         String            @default("") @db.VarChar(64)
  entity_type             String            @default("BUDGET_CONSOLIDATION") @db.VarChar(64)
  entry_route             EntryRoute        @default(STRATEGIC)
  record_status           String?           @db.VarChar(64)
  approval_status         ApprovalDecision?
  owning_business_unit_id String?           @db.VarChar(255)
  record_owner_user_id    String?           @db.VarChar(128)
  fiscal_year             Int?
  version_number          Int               @default(1)
  created_by              String            @default("system") @db.VarChar(128)
  created_at              DateTime          @default(now())
  modified_by             String?           @db.VarChar(128)
  modified_at             DateTime?         @updatedAt
  is_active               Boolean           @default(true)
  is_locked               Boolean           @default(false)

  budget_submission BudgetSubmission @relation(fields: [budget_submission_id], references: [budget_submission_id], onDelete: Restrict)

  @@index([master_trace_id])
  @@map("budget_consolidation")
}

// ─────────────────────────────────────────────
// Procurement Execution Ledger (15_Procurement Updates)
// ─────────────────────────────────────────────

model ProcurementStatusUpdate {
  // PSU-001/002 Identity
  update_id                   String    @id @db.VarChar(64)
  procurement_item_id         String    @db.VarChar(64)
  // PSU-003/004 Stage transition (existing)
  previous_stage              String    @db.VarChar(64)
  new_stage                   String    @db.VarChar(64)
  // PSU-005/006 Status + timestamp (previously missing)
  overall_status              String?   @db.VarChar(64) // Not Started | On Track | At Risk | Delayed | On Hold | Completed | Cancelled
  update_at                   DateTime  @default(now()) // PSU-006 effective timestamp
  // PSU-007/008 Progress + milestone
  progress_pct                Decimal   @db.Decimal(5, 2)
  milestone_code              String?   @db.VarChar(64) // PSU-008
  // PSU-009/010/011 Milestone dates + variance
  planned_milestone_date      DateTime?
  actual_milestone_date       DateTime?
  milestone_variance_days     Int? // PSU-011 signed integer (positive = late)
  // PSU-012/013/014/015 SAP/ERP references
  purchase_requisition_id     String?   @db.VarChar(128) // PSU-012
  purchase_requisition_status String?   @db.VarChar(64) // PSU-013
  rfx_id                      String?   @db.VarChar(128) // PSU-014
  award_id                    String?   @db.VarChar(128) // PSU-015
  // PSU-016/017 PO + Contract
  purchase_order_id           String?   @db.VarChar(128)
  contract_id                 String?   @db.VarChar(128)
  // PSU-018/019/020/021 Value tracking
  commitment_value            Decimal?  @db.Decimal(18, 2) // PSU-018 transaction currency
  commitment_value_sar        Decimal?  @db.Decimal(18, 2) // PSU-019
  invoiced_value_sar          Decimal?  @db.Decimal(18, 2) // PSU-020
  paid_value_sar              Decimal?  @db.Decimal(18, 2) // PSU-021
  forecast_final_value_sar    Decimal   @db.Decimal(18, 2) // PSU-022
  // PSU-023/024 Delivery
  delivered_quantity          Decimal?  @db.Decimal(18, 4) // PSU-023
  accepted_quantity_value     Json? // PSU-024 { quantity, sar_value }
  // PSU-025 Forecast completion
  forecast_completion_date    DateTime? // PSU-025
  // PSU-026/027/028/029/030 Exception handling (previously missing from model)
  exception_reason            String?   @db.Text // PSU-026 (CRITICAL — required for delayed/at-risk)
  impact_assessment           String?   @db.Text // PSU-027
  corrective_action           String?   @db.Text // PSU-028
  action_owner_user_id        String?   @db.VarChar(128) // PSU-029
  action_due_date             DateTime? // PSU-030
  // PSU-031/032 Evidence + validation
  evidence_attachment_ids     Json? // PSU-031
  update_validation_status    String    @db.VarChar(64) // PSU-032 Not Required | Pending | Validated | Returned

  // Shared fields (04_Shared Fields)
  master_trace_id         String     @default("") @db.VarChar(64)
  entity_type             String     @default("PROCUREMENT_STATUS_UPDATE") @db.VarChar(64)
  entry_route             EntryRoute @default(STRATEGIC)
  record_status           String?    @db.VarChar(64)
  owning_business_unit_id String?    @db.VarChar(255)
  record_owner_user_id    String?    @db.VarChar(128)
  fiscal_year             Int?
  version_number          Int        @default(1)
  created_by              String     @default("system") @db.VarChar(128)
  created_at              DateTime   @default(now())
  modified_by             String?    @db.VarChar(128)
  modified_at             DateTime?  @updatedAt
  is_active               Boolean    @default(true)
  is_locked               Boolean    @default(false)

  procurement_item ProcurementItem @relation(fields: [procurement_item_id], references: [procurement_item_id], onDelete: Restrict)

  @@index([procurement_item_id])
  @@index([new_stage])
  @@index([overall_status])
  @@index([master_trace_id])
  @@map("procurement_status_update")
}

