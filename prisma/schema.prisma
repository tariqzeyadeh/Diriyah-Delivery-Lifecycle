  unit_of_measure            String?   @db.VarChar(255)
  decimal_precision          Int?
  calculation_formula        String?   @db.Text
  numerator_definition       String?   @db.Text
  denominator_definition     String?   @db.Text
  aggregation_method         String?   @db.VarChar(255)
  is_cumulative              Boolean?
  baseline_value             Decimal?  @db.Decimal(18, 2)
  baseline_period            String?   @db.VarChar(64)
  baseline_source            String?   @db.VarChar(255)
  target_setting_method      String?   @db.VarChar(255)
  target_rationale           String?   @db.Text
