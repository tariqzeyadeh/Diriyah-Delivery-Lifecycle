  objective_id                    String    @id @db.VarChar(64)
  theme_id                        String?   @db.VarChar(255)
  objective_name                  String    @db.VarChar(255)
  objective_description           String?   @db.Text
  intended_outcome                String?   @db.Text
  bsc_perspective                 String?   @db.VarChar(255)
  objective_type                  String?   @db.VarChar(255)
  objective_owner_user_id         String?   @db.VarChar(128)
  performance_coordinator_user_id String?   @db.VarChar(128)
  objective_start_date            DateTime?
  objective_end_date              DateTime?
  objective_priority              String?   @db.VarChar(255)
  objective_weight_pct            Decimal?  @db.Decimal(18, 2)
  baseline_narrative              String?   @db.Text
  target_outcome_date             DateTime?
  kpi_ids                         Json?
  kpi_weight_check                Boolean?
