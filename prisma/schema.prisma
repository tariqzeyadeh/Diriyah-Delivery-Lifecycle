  amber_threshold            String?   @db.VarChar(255)
  red_threshold              String?   @db.VarChar(255)
  kpi_weight_pct             Decimal?  @db.Decimal(18, 2)
  score_cap_pct              Decimal?  @db.Decimal(18, 2)
  binary_success_value       String?   @db.VarChar(255)
  collection_frequency       String?   @db.VarChar(255)
  reporting_frequency        String?   @db.VarChar(255)
  kpi_owner_user_id          String?   @db.VarChar(128)
  data_steward_user_id       String?   @db.VarChar(128)
  data_validator_user_id     String?   @db.VarChar(128)
  kpi_source_system          String?   @db.VarChar(255)
  source_dataset             String?   @db.VarChar(255)
  source_field_mapping       String?   @db.Text
  collection_method          String?   @db.VarChar(255)
  data_quality_rules         Json?
  submission_due_offset_days Int?
  validation_due_offset_days Int?
  definition_effective_date  DateTime?
  definition_change_reason   String?   @db.Text
  objective_id               String    @db.VarChar(64)

  // Shared fields (04_Shared Fields)
  master_trace_id         String            @db.VarChar(64)
  entity_type             String            @db.VarChar(64)
  parent_record_id        String?           @db.VarChar(255)
  entry_route             EntryRoute
  lifecycle_phase         String?           @db.VarChar(64)
  current_stage_code      String?           @db.VarChar(255)
  record_status           String?           @db.VarChar(64)
  approval_status         ApprovalDecision?
  rag_status              RagStatus?
  owning_business_unit_id String?           @db.VarChar(255)
  record_owner_user_id    String?           @db.VarChar(128)
  delegate_user_id        String?           @db.VarChar(128)
  fiscal_year             Int?
  version_number          Int               @default(1)
  version_status          VersionStatus?
  created_by              String            @db.VarChar(128)
  created_at              DateTime          @default(now())
  modified_by             String?           @db.VarChar(128)
  modified_at             DateTime?         @updatedAt
  submitted_by            String?           @db.VarChar(128)
  submitted_at            DateTime?
  source_system           String?           @db.VarChar(64)
  external_system_key     String?           @db.VarChar(255)
  last_sync_at            DateTime?
  data_classification     String?           @db.VarChar(64)
  retention_class         String?           @db.VarChar(255)
  is_active               Boolean           @default(true)
  is_locked               Boolean           @default(false)

  objective StrategicObjective     @relation(fields: [objective_id], references: [objective_id], onDelete: Restrict)
